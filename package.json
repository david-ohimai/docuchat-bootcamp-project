{
  "name": "docuchat",
  "version": "1.0.0",
  "description": "AI-powered document Q&A backend: upload documents, ask questions, get answers with citations (RAG over pgvector).",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate"
  },
  "keywords": ["rag", "pgvector", "express", "typescript", "openai", "bullmq"],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@bull-board/api": "^6.21.3",
    "@bull-board/express": "^6.21.3",
    "@prisma/client": "^6.19.3",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.81.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "opossum": "^8.5.0",
    "pdf-parse": "^1.1.4",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.3.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "xss": "^1.0.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/opossum": "^8.1.8",
    "@types/pdf-parse": "^1.1.4",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
