# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3000

# PostgreSQL with pgvector (docker compose up -d starts one on 5432)
DATABASE_URL="postgresql://docuchat:docuchat_dev@localhost:5432/docuchat"

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The two secrets must be different.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# Redis (cache, rate limits, BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# OpenAI (embeddings + chat completions)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# CORS: the only browser origin allowed to call the API
FRONTEND_URL=http://localhost:3001

# Run the document worker inside the API process (fine for dev).
# Set to false in production and run `npm run start:worker` separately.
RUN_WORKER_IN_PROCESS=true
